{
  "name": "linear-strict",
  "version": "0.1.0",
  "mcpName": "io.github.justinstimatze/linear-strict",
  "description": "Unofficial, opinionated Linear MCP server: reads tickets whole, keeps the description as current state, and enforces its rules in the server. Not affiliated with Linear.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "linear-strict": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint src evals",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip",
    "test": "npm run check && npm run test:unit && npm run test:mcp-smoke && npm run test:e2e",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:mcp-smoke": "npm run build && node scripts/mcp-smoke-test.mjs",
    "test:live": "npm run build && node scripts/live-test.mjs",
    "eval": "tsx evals/run.ts",
    "format": "prettier --write \"src/**/*.ts\" \"evals/**/*.ts\"",
    "knip": "knip",
    "format:check": "prettier --check \"src/**/*.ts\" \"evals/**/*.ts\"",
    "prepare": "npm run build",
    "test:e2e": "npm run build && node scripts/e2e/sign-off.mjs"
  },
  "keywords": [
    "agents",
    "claude",
    "claude-code",
    "issue-tracker",
    "linear",
    "linear-app",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "project-management"
  ],
  "author": "Justin Stimatze <justin@justinstimatze.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinstimatze/linear-strict.git"
  },
  "homepage": "https://github.com/justinstimatze/linear-strict#readme",
  "bugs": {
    "url": "https://github.com/justinstimatze/linear-strict/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "knip": "^6.38.0",
    "prettier": "^3.5.2",
    "ts-jest": "^29.2.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
